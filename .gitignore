# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
# Anchored to the repo root on purpose: an unanchored `node_modules/` matches at
# ANY depth, which silently excluded the web build's own assets (Expo emits fonts
# and nav icons under dist/assets/node_modules/...). That shipped a demo whose
# icon font 404'd on GitHub Pages while working fine locally.
/node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# IDE
.idea/
